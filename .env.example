# ------------------------------------------------------------------
# PromptHub Enterprise - configuration
# Copy to .env and adjust. Everything is local by default.
# ------------------------------------------------------------------

APP_NAME=PromptHub Enterprise
APP_ENV=development
DEBUG=true

# Database
# Leave empty to use a local SQLite file (fastest for a self-hosted demo).
# For PostgreSQL (recommended for a realistic deployment) set, e.g.:
# DATABASE_URL=postgresql+psycopg2://prompthub:prompthub@localhost:5432/prompthub
DATABASE_URL=

# ------------------------------------------------------------------
# LLM provider: auto | mock | ollama | openai
#   auto  -> use Ollama if reachable, otherwise fall back to the Mock provider
#   mock  -> deterministic template-based responses, no LLM required
#   ollama-> local inference via Ollama
#   openai-> remote OpenAI-compatible API (requires API key)
# ------------------------------------------------------------------
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# OpenAI provider (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# RAG / knowledge grounding
# RAG_MODE=local      -> keyword retrieval over the local document store (default, zero deps)
# RAG_MODE=qdrant     -> vector retrieval (requires a running Qdrant)
RAG_MODE=local
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Security
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_EXPIRY_MINUTES=720

# Authentication
# false -> the demo signs in automatically as the seeded Administrator user
# true  -> require username/password login
ENABLE_AUTH=false

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
